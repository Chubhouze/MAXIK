# Installed by install.sh --server (@USER@ and @DIR@ are filled in there).
[Unit]
Description=M.A.X.I.K. plant analysis web page
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=MAXIK_PORT=5055
EnvironmentFile=-@DIR@/robot.conf
ExecStart=@DIR@/.venv/bin/waitress-serve --host=0.0.0.0 --port=${MAXIK_PORT} --threads=2 webapp:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
